# Copy this file to .env and fill in the values. Never commit the real .env file.

# Port the API listens on
PORT=5000

# MongoDB connection string (local or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/lead-manager

# Secret used to sign login tokens (JWT). Use a long random string.
JWT_SECRET=replace-with-a-long-random-string

# Origin of the frontend, allowed to call this API (CORS)
CLIENT_ORIGIN=http://localhost:5173

# Optional. Only set this if you see "querySrv ECONNREFUSED" when connecting
# to MongoDB Atlas. Uses public DNS servers for the Atlas address lookup.
# DNS_SERVERS=8.8.8.8,1.1.1.1
